#!/usr/bin/env bash

# --- OS Repo ---
OS_CODENAME="jammy"                   # Distrib jammy 22.04 ubuntu
ONE_REPO_MAJOR="6.10"                 # Version  OpenNebula 
ONE_REPO_CHANNEL="stable"             # Canal du repo: stable | testing
ONE_REPO_NAME="opennebula"            # Nom composant APT 

# --- Réseau et hôtes ---
FRONTEND_HOSTNAME="one-frontend"      # Hostname du serveur Frontend
FRONTEND_IP="192.168.56.10"           # IP du Front (Sunstone écoute ici)
NODE_HOSTNAME="one-node1"             # Hostname du Node KVM
NODE_IP="192.168.56.11"               # IP du Node KVM

# --- Accès Dashboard ---
SUNSTONE_PORT="9869"                  # Port du dashboard Sunstone

# --- SSH entre Frontend et Node ---
SSH_TARGET_USER="oneadmin"            # Compte cible sur le node (oneadmin créé par le paquet)
NODE_SSH_PASSWORD=""                  # Paassword pour bootstrap ssh-copy-id (vide poru une demande interactive)
SSH_KEY_TYPE="ed25519"                # Type SSH ed25519
CREATE_SSH_KEY_IF_MISSING="true"      # Génère une clé pour $SSH_TARGET_USER

# --- Réseau bridge ---
CONFIGURE_NETPLAN_BRIDGE="false"      # true = configure un bridge via Netplan (peut cut la session SSH)
BRIDGE_NAME="br0"                     # Nom du bridge à créer si activé
PHYS_IFACE="eno1"                     # Interface physique associée au bridge
BRIDGE_CIDR="${FRONTEND_IP}/24"       # CIDR à poser si tu config le bridge via Netplan
GATEWAY_IP="192.168.56.1"             # Gateway
DNS_SERVERS="8.8.8.8,1.1.1.1"         # DNS

# --- Roles et options ---
ADD_FRONTEND_AS_COMPUTE="false"       # true = le Front sera aussi ajouté comme hôte KVM
DATASTORE_DIR="/var/lib/one/datastores" # Répertoire datastores
TIMEZONE="Europe/Paris"               # TZ système à forcer

# --- Paquetset services ---
EXTRA_FRONTEND_PACKAGES="jq curl"     # Paquets utilitaires en + côté frontend
EXTRA_NODE_PACKAGES="jq curl"         # Paquets utilitaires en + côté node

# --- Sécurité et idempotence ---
NON_INTERACTIVE="true"                # true = apt sans prompts
SET_STRICT_BASH="true"                # true = set -euo pipefail dans les scripts
